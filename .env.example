# Copy to .env for local development. Placeholders only - never put real values here.
# Only the variables below are read by the current build. Variables for later phases
# (Redis, market-data provider, MLflow, AI provider, broker credentials) are listed in
# QUANTLAB_CODEX_MASTER_SPEC.md section 18 and get added when their phase is built.

APP_ENV=development
APP_NAME=QUANTLAB
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Matches the local-only credentials in docker-compose.yml. Not for any shared environment.
DATABASE_URL=postgresql+psycopg://quantlab:quantlab@localhost:5433/quantlab

# This build accepts only: RESEARCH_ONLY, EXECUTION_DISABLED, EMERGENCY_STOP.
EXECUTION_MODE=RESEARCH_ONLY
# This build accepts only: disabled.
BROKER_MODE=disabled
